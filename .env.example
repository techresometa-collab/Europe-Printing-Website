# =============================================
# Crafty Printing – Environment Variables
# =============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Google Apps Script Web App URL for Contact Form → Google Sheets
# Setup: Create a Google Apps Script project, deploy as Web App,
# paste the deployment URL here.
# See: src/pages/ContactUs.jsx for the required script format.
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# WhatsApp Business Number (include country code, no + or spaces)
# Example: Portugal +351 912 345 678 → 351912345678
VITE_WHATSAPP_NUMBER=351912345678

# Business email (shown on Contact page)
VITE_BUSINESS_EMAIL=hello@craftyprintings.com

# Business phone (display format)
VITE_BUSINESS_PHONE=+351 912 345 678

# Business address
VITE_BUSINESS_ADDRESS=Rua Exemplo, 123, Lisboa, Portugal

# Google Maps embed URL (replace with your actual location)
VITE_MAPS_EMBED_URL=https://maps.google.com/maps?q=Lisboa,Portugal&output=embed
